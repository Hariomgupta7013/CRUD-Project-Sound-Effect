<%- include("include/navBoilerPlate.ejs") %>

<style>
    .new-post-form {
        width: 50%;
        margin: 20px auto;
        padding: 15px;
    }

    /* Tablet */
    @media (max-width: 768px) {
        .new-post-form {
            width: 80%;
        }
    }

    /* Mobile */
    @media (max-width: 576px) {
        .new-post-form {
            width: 94%;
            padding: 10px;
        }

        .new-post-form button {
            width: 100%;
        }
    }
</style>

    <body>
        <form method="post" action="/home" class=" new-post-form">
            <div class="container mt-3">
                <div class="mb-3">
                    <label class="form-label">Enter user name</label>
                    <input name="userName" type="text" class="form-control" placeholder="Enter your user name">
                </div>

                <div class="mb-3">
                    <label class="form-label">Enter Image URL</label>
                    <input name="image" type="text" class="form-control" placeholder="Enter image-url">
                </div>

                <div class="mb-3">
                    <label class="form-label">Content</label>
                    <textarea name="content" type="text" class="form-control" placeholder="Write you content"
                        rows="3"> </textarea>
                </div>
                <button class="btn btn-primary" type="submit">Done</button>
            </div>

        </form>




    </body>