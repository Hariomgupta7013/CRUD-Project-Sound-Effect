<%- include("include/navBoilerPlate.ejs") %>
    <style>
    .container {
        width: 50%;
        margin: 20px auto 50px;
    }

    .container img {
        width: 100%;
        max-width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
    }

    .container textarea {
        width: 100%;
        box-sizing: border-box;
        resize: vertical;
    }

    .done-btn {
        width: 100%;
        font-size: 1.3rem;
        padding: 8px;
    }

    /* Tablet */
    @media (max-width: 768px) {
        .edit-container {
            width: 80%;
        }
    }

        /* Mobile */
    @media (max-width: 576px) {
        .container {
            width: 94%;
            margin-top: 15px;
        }

        .container h3 {
            font-size: 1.5rem;
        }

        .container p {
            font-size: 14px;
        }
        .container img{
            width: 100%;
            height: auto;
        }

        .done-btn {
            font-size: 1.1rem;
        }
    }
</style>
    <body>
        <div class="container">
            <h3 class="mb-3 read-text">
               <b>@</b><%= post.userName %>
            </h3>
            <p>
               <b>Id:-</b><%= post.id %>
            </p>
            <img src="<%= post.image %>" alt="image">
            <p class="mt-3 read-text">
               <b>Content:-</b><%= post.content %>
            </p>
            <div class="buttons mt-2">
                <a href="/home/<%= post.id %>/edit"><button class="btn btn-primary">Edit</button></a>
                <a href="/home"><button class="btn btn-dark">Back</button></a>
            </div>
        </div>

    </body>