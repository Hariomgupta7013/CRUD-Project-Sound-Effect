<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hariom Social Media App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/nav.css">
</head>

<body>
    <!-- Navbar -->

    <nav>

        <!-- Website Home Link -->
        <a href="/home" class="navbar-title read-text">

            <h1 style="color: white;">
                Hariom Social Media App
            </h1>

        </a>


        <!--Right Side Voice Controls-->

        <div class="voice-controls">
            <!-- Sound ON/OFF Button -->
            <button id="soundToggle" class="sound-toggle on" type="button">Sound ON</button>
            <!-- Voice Settings Button -->
            <button id="voiceSettingsButton" class="voice-settings-button" type="button">Voice Settings</button>
        </div>
    </nav>

    <!-- Voice Settings Panel -->
    <div id="voicePanel" class="voice-panel">
        <!-- Heading -->
        <h3>
             Voice Settings
        </h3>

        <!-- Voice Gender -->
        <div class="control-group">
            <label for="genderSelect">Voice</label>
            <select id="genderSelect">
                <option value="female">Female Voice</option>
                <option value="male">Male Voice</option>
            </select>
        </div>



        <!-- Language -->
        <div class="control-group">
            <label for="languageSelect">Language</label>
            <select id="languageSelect">
                <option value="hi-IN">Hindi</option>
                <option value="en-US">English</option>
            </select>
        </div>

        <!-- Available Voice -->
        <div class="control-group">
            <label for="voiceSelect">Available Voice</label>
                <select id="voiceSelect">
                <option>Loading voices...</option>
            </select>
        </div>



        <!--Speech Speed-->
        <div class="control-group">
            <label for="speedRange">Speed:
                <span id="speedValue">1x</span>
            </label>
            <input type="range" id="speedRange" min="0.5" max="2" step="0.1" value="1">
        </div>



        <!-- Volume -->
        <div class="control-group">
            <label for="volumeRange">Volume:<span id="volumeValue">100%</span></label>
            <input type="range" id="volumeRange" min="0" max="1" step="0.1" value="1">
        </div>

        <!-- Done Button -->
        <button id="doneVoicePanel" class="close-voice-panel" type="button"> Done </button>
    </div>


    <script src="/js/sound.js" defer></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>

</html>